# Copy to deploy/aws/config.env and edit before running the scripts.
# Do not commit config.env; it may contain account-specific values.

AWS_PROFILE=opsflow-dev
AWS_REGION=ap-southeast-2

PROJECT=opsflow
ENV=staging
TENANT=mediconnect
TARGET_REPO=UzairAjaz/mediconnnect
TARGET_SERVICE=mediconnect-backend
MANAGER_EMAIL=uzairejaz987@gmail.com
OPSFLOW_REPO=UzairAjaz/OpsflowAI
TARGET_LOG_GROUP=/ecs/mediconnect-backend

# Domain is optional. Leave empty to use the ALB DNS over HTTP for staging.
# For GitHub webhooks and production, provide a domain in Route53:
# DOMAIN_NAME=opsflow.example.com
# HOSTED_ZONE_ID=Z0123456789ABCDEFGHIJ
DOMAIN_NAME=
HOSTED_ZONE_ID=

# Network CIDRs. Change if they overlap an existing VPC.
VPC_CIDR=10.20.0.0/16
PUBLIC_SUBNET_1_CIDR=10.20.0.0/20
PUBLIC_SUBNET_2_CIDR=10.20.16.0/20
PRIVATE_SUBNET_1_CIDR=10.20.32.0/20
PRIVATE_SUBNET_2_CIDR=10.20.48.0/20

# Staging sizing. Increase for production.
DB_INSTANCE_CLASS=db.t4g.micro
DB_ALLOCATED_STORAGE=20
DB_ENGINE_VERSION=16.4
REDIS_NODE_TYPE=cache.t4g.micro
REDIS_ENGINE_VERSION=7.1
