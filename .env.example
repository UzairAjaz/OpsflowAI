# OpsFlow AI environment configuration.
# Copy this file to .env and adjust values for your environment.

# LLM / Ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0

# Graph tuning
MAX_LOOPS=3
CONFIDENCE_THRESHOLD=70
WEB_MAX_RESULTS=5

# Execution and safety
DRY_RUN=true
AUTO_APPROVE=false
CHECKPOINT_DB=opsflow.sqlite

# Phase 2: API service
API_HOST=0.0.0.0
API_PORT=8000

# Phase 2: PostgreSQL (durable state and audit)
DATABASE_URL=postgresql+psycopg://opsflow:opsflow@localhost:5432/opsflow

# Phase 2: Redis (queue, rate limiting, caching)
REDIS_URL=redis://localhost:6379/0

# Phase 2: Checkpointer backend: "memory" or "postgres"
CHECKPOINTER=memory

# Phase 2: Webhook security (replace with a strong secret)
WEBHOOK_SECRET=dev-secret-change-me

# Phase 2: Alert ingestion
ALERT_RATE_LIMIT_PER_MINUTE=50
ALERT_RATE_LIMIT_WINDOW_SECONDS=60
ALERT_DEDUPE_WINDOW_SECONDS=300

# Phase 2: Severity classification (rules always run; LLM refines when true)
SEVERITY_USE_LLM=false

# Phase 2: Knowledge base (multi-tenant RAG)
KB_BACKEND=none
KB_FALLBACK_ENABLED=true
KB_NAMESPACE_PREFIX=tenant_
KB_TIMEOUT_SECONDS=5
TENANT_KB_BASE_URL=http://localhost:9200
TENANT_KB_API_KEY=
LIVE_CONNECTOR_BASE_URL=
LIVE_CONNECTOR_API_KEY=
HISTORY_PREFERENCE_THRESHOLD=0.7

# Phase 2: Sandbox execution (safe apply + validation)
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=alpine:3.20
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPUS=0.5
SANDBOX_NETWORK=false
SANDBOX_MAX_ATTEMPTS=2

# Phase 2: Notifications and approvals
PUBLIC_BASE_URL=http://localhost:8000
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=opsflow@example.com
SMTP_TO=oncall@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=
PAGERDUTY_ROUTING_KEY=
APPROVAL_TOKEN_SECRET=dev-approval-secret
APPROVAL_TOKEN_TTL_MINUTES=120
ESCALATION_MINUTES=15,30,60

# Phase 2: Per-tenant API keys ("tenant:key,tenant2:key2"; empty disables auth)
TENANT_API_KEYS=

# Phase 2: Canary deployment
CANARY_BACKEND=simulated
CANARY_STEPS=10,25,50,100
CANARY_ERROR_RATE_THRESHOLD=0.05
CANARY_P95_THRESHOLD_MS=500
PROMETHEUS_URL=
ARGO_NAMESPACE=default

# Phase 2: Observability and learning
OTEL_ENABLED=false
OTEL_EXPORTER=memory
OTEL_ENDPOINT=
FEEDBACK_HORIZON_HOURS=24
EVALS_PATH=evals/dataset.jsonl
