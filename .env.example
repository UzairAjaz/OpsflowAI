# OpsFlow AI environment configuration.
# Copy this file to .env and adjust values for your environment.

# LLM / Ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_CHUNK_SIZE=800
EMBEDDING_CHUNK_OVERLAP=100
LLM_TEMPERATURE=0

# Graph tuning
MAX_LOOPS=3
CONFIDENCE_THRESHOLD=70
WEB_MAX_RESULTS=5

# Execution and safety
DRY_RUN=true
AUTO_APPROVE=false
CHECKPOINT_DB=opsflow.sqlite

# Phase 2: API service
API_HOST=0.0.0.0
API_PORT=8000

# Phase 2: PostgreSQL (durable state and audit)
# Docker Compose reads POSTGRES_* / REDIS_PORT directly; keep them in sync
# with DATABASE_URL and REDIS_URL below.
DATABASE_URL=postgresql+psycopg://opsflow:opsflow@localhost:5432/opsflow
POSTGRES_USER=opsflow
POSTGRES_PASSWORD=opsflow
POSTGRES_DB=opsflow
POSTGRES_PORT=5432

# Phase 2: Redis (queue, rate limiting, caching)
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Phase 2: Checkpointer backend: "memory" or "postgres"
CHECKPOINTER=memory

# Phase 2: Webhook security (replace with a strong secret)
WEBHOOK_SECRET=dev-secret-change-me

# Phase 2: Alert ingestion
ALERT_RATE_LIMIT_PER_MINUTE=50
ALERT_RATE_LIMIT_WINDOW_SECONDS=60
ALERT_DEDUPE_WINDOW_SECONDS=300

# Phase 2: Severity classification (rules always run; LLM refines when true)
SEVERITY_USE_LLM=false

# Phase 2: Knowledge base (multi-tenant RAG)
KB_BACKEND=none
KB_FALLBACK_ENABLED=true
RULEBOOK_RETRIEVAL_ENABLED=true
KB_NAMESPACE_PREFIX=tenant_
KB_TIMEOUT_SECONDS=5
TENANT_KB_BASE_URL=http://localhost:9200
TENANT_KB_API_KEY=
LIVE_CONNECTOR_BASE_URL=
LIVE_CONNECTOR_API_KEY=
HISTORY_PREFERENCE_THRESHOLD=0.7

# Phase 2: Sandbox execution (safe apply + validation)
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=alpine:3.20
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPUS=0.5
SANDBOX_NETWORK=false
SANDBOX_MAX_ATTEMPTS=2
DEFAULT_MEMORY_LIMIT=2Gi

# Phase 2: Notifications and approvals
PUBLIC_BASE_URL=http://localhost:8000
# Optional explicit alert destination (defaults to PUBLIC_BASE_URL + ALERT_WEBHOOK_PATH)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_PATH=/api/v1/webhooks/alert
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=

# --- Email service (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="OpsFlow <opsflow@example.com>"
SMTP_TO=oncall@example.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=
PAGERDUTY_ROUTING_KEY=
APPROVAL_TOKEN_SECRET=dev-approval-secret
APPROVAL_TOKEN_TTL_MINUTES=120
ESCALATION_MINUTES=15,30,60
ESCALATION_RECIPIENTS=manager,senior_manager,cto

# Phase 2: Per-tenant API keys ("tenant:key,tenant2:key2"; empty disables auth)
# Format: tenant_id:role:api_key, or legacy tenant_id:api_key.
# Example: TENANT_API_KEYS=mediconnect:approver:change-me,mediconnect:viewer:view-me
TENANT_API_KEYS=
# Local demo convenience. Set AUTH_DEV_MODE=false in production.
AUTH_DEV_MODE=true
DEV_TENANT_ID=mediconnect
AUTH_JWT_SECRET=opsflow-dev-jwt-secret-change-me-please
AUTH_TOKEN_TTL_MINUTES=60

# Phase 2: Canary deployment
CANARY_BACKEND=simulated
CANARY_STEPS=10,25,50,100
CANARY_ERROR_RATE_THRESHOLD=0.05
CANARY_P95_THRESHOLD_MS=500
PROMETHEUS_URL=
ARGO_NAMESPACE=default

# Phase 2: Observability and learning
OTEL_ENABLED=false
OTEL_EXPORTER=memory
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=opsflow-ai
FEEDBACK_HORIZON_HOURS=24
EVALS_PATH=evals/dataset.jsonl
WORKER_JOB_TIMEOUT_SECONDS=1800

# Centralized runtime settings
ENVIRONMENT=local
APP_NAME=OpsFlow AI API
APP_VERSION=0.1.0
SERVICE_NAME=opsflow-api
LOG_LEVEL=INFO

QUEUE_NAME=incidents
QUEUE_RESULT_TTL_SECONDS=300
QUEUE_FAILURE_TTL_SECONDS=300
REPORTS_DIR=reports
DEPLOY_K8S_DIR=deploy/k8s

WEBHOOK_SIGNATURE_HEADER=X-Signature
AUTH_JWT_ALGORITHM=HS256

TENANT_KB_SEARCH_PATH=/v1/search
LIVE_CONNECTOR_SEARCH_PATH=/v1/search

NOTIFICATION_TIMEOUT_SECONDS=10
TWILIO_API_BASE_URL=https://api.twilio.com

DEMO_TENANT_ID=mediconnect
DEMO_TENANT_NAME=MediConnect
DEMO_SERVICE=mediconnect-backend
DEMO_ERROR_CLASS=OOMKilled
DEMO_EMAIL=admin@mediconnect.local
DEMO_APPROVER=demo-cli
CLI_APPROVER=cli-user

ARGO_PROMETHEUS_ADDRESS=http://prometheus.monitoring:9090
